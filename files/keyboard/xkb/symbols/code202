    key <LatF>	{ [         f,          F ]	};
    key <LatG>	{ [         g,          G ]	};
    key <LatH>	{ [         h,          H ]	};
    key <LatI>	{ [         i,          I,   ediaeresis ]	};
    key <LatJ>	{ [         j,          J,     EuroSign ]	};
    key <LatK>	{ [         k,          K,      section ]	};
